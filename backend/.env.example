PORT=3000

# Production: set DATABASE_URL to a PostgreSQL connection string (e.g. Neon/Render).
# DATABASE_URL=postgres://user:password@host:5432/jobs
# DATABASE_SSL=true

# Local development: leave DATABASE_URL unset to use a SQLite file.
SQLITE_PATH=data/jobs.sqlite

# Comma-separated list of allowed frontend origins. Leave unset to allow all.
# CORS_ORIGIN=http://localhost:5173,https://your-frontend.pages.dev
